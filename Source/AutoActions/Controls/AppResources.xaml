  <!--  TRAY CONTEXT MENU — FLUENT STYLE                             -->
  <!--  A self-contained WPF ContextMenu template: rounded corners,  -->
  <!--  system font, semi-transparent surface, WinUI-style hover,    -->
  <!--  and proper submenu arrow. Used by TrayMenuHelper for the      -->
  <!--  tray right-click menu.                                        -->
  <!--                                                                -->
  <!--  Colors are DynamicResource so they follow the light/dark     -->
  <!--  palette merged at startup (AppResources + DarkColors).       -->
  <!--  The surface uses a semi-opaque brush that mimics the Fluent   -->
  <!--  Acrylic/Mica look without requiring DWM backdrop (which is   -->
  <!--  incompatible with WPF AllowsTransparency popups on .NET FW). -->
  <!-- ============================================================= -->
  <!-- Tray menu surface brush: ~92% opaque neutral. Resolves per-theme. -->
  <SolidColorBrush x:Key="TrayMenuSurfaceBrush" Color="{DynamicResource WindowColor}" Opacity="0.92" />
  <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="{DynamicResource ControlMediumColor}" Opacity="0.6" />
  <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="{DynamicResource AccentColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="{DynamicResource GlyphColor}" Opacity="0.25" />
  <!-- Top-level ContextMenu template. -->
  <ControlTemplate x:Key="TrayContextMenuTemplate" TargetType="{x:Type ContextMenu}">
    <Border Background="{StaticResource TrayMenuSurfaceBrush}" BorderBrush="{StaticResource TrayMenuBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" SnapsToDevicePixels="True">
      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0" />
    </Border>
  </ControlTemplate>
  <!-- MenuItem template — supports: header item, normal item, separator, submenu. -->
  <Style x:Key="TrayMenuItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid Background="Transparent">
            <!-- Rounded hover/selection highlight -->
            <Border x:Name="PART_Hover" Background="Transparent" CornerRadius="4" Margin="2,1" />
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- icon -->
                <ColumnDefinition Width="*" />
                <!-- header -->
                <ColumnDefinition Width="Auto" />
                <!-- submenu arrow -->
              </Grid.ColumnDefinitions>
              <!-- Icon: when no icon is set the ContentPresenter
                                 is empty so the column auto-sizes to 0 and the
                                 text sits flush-left (aligned with no-icon items
                                 like Shutdown). When an icon exists it gets a
                                 12px left margin + 8px right gap. -->
              <ContentPresenter x:Name="Icon" Grid.Column="0" Content="{TemplateBinding Icon}" ContentSource="Icon" Margin="12,0,8,0" VerticalAlignment="Center" Width="16" Height="16" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentStringFormat="{TemplateBinding HeaderStringFormat}" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" />
              <!-- Submenu arrow: shown only when this item hosts a submenu -->
              <Path x:Name="PART_SubmenuArrow" Grid.Column="2" Visibility="Collapsed" Fill="{DynamicResource GlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L6,5 L0,10 Z" />
              <!-- Popup for submenu -->
              <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource TrayMenuSurfaceBrush}" BorderBrush="{StaticResource TrayMenuBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- No icon set: collapse the icon column entirely so
                             text is not pushed right by an empty 16px placeholder. -->
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Show arrow + don't toggle popup for items that have a submenu -->
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="PART_SubmenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Hover -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="PART_Hover" Property="Background" Value="{StaticResource TrayMenuHoverBrush}" />
            </Trigger>
            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Default ContextMenu style that applies the template above. -->
  <!-- NOTE: ItemContainerStyle is NOT set here, because it would also be
         applied to Separator items (which are not MenuItem), causing a
         "Style for MenuItem cannot be applied to type Separator" crash.
         Instead, the MenuItem style is applied per-item in code
         (TrayMenuHelper.RebuildMenuItems sets each MenuItem.Style). -->
  <Style x:Key="TrayContextMenuStyle" TargetType="{x:Type ContextMenu}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template" Value="{StaticResource TrayContextMenuTemplate}" />
    <!-- Separator style scoped to this ContextMenu only. -->
    <Style.Resources>
      <Style TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource TrayMenuSeparatorBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Margin="{TemplateBinding Margin}" Background="{TemplateBinding Background}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
